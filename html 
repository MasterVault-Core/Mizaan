window.pasteSeed = async function() {
  try {
    const text = await navigator.clipboard.readText();
    const words = text.trim().split(/\s+/);
    if (words.length >= 12) {
      for (let i = 0; i < Math.min(words.length, 24); i++) {
        document.getElementById(`seed-${i}`).value = words[i];
      }
      showToast(`Pasted ${Math.min(words.length, 24)} words`, 'success');
    } else {
      showToast('Clipboard does not contain enough words', 'error');
    }
  } catch (e) {
    showToast('Could not read clipboard', 'error');
  }
};

function getSeedPhrase() {
  const words = [];
  for (let i = 0; i < 24; i++) {
    const v = document.getElementById(`seed-${i}`).value.trim().toLowerCase();
    if (v) words.push(v);
  }
  return words.join(' ');
}

window.recoverWallet = async function() {
  const phrase = getSeedPhrase();
  if (!bip39.validateMnemonic(phrase)) {
    showToast('Invalid BIP39 mnemonic checksum', 'error');
    return;
  }

  showToast('Deriving BIP84 addresses offline...', 'info');

  try {
    const seed = await bip39.mnemonicToSeed(phrase);
    const root = bip32.fromSeed(seed);
    const account = root.derivePath("m/84'/0'/0'");
    const external = account.deriveChild(0);

    const derived = [];
    const listEl = document.getElementById('derived-list');
    listEl.innerHTML = '<div class="loading"><div class="spinner"></div> Scanning indices...</div>';
    document.getElementById('derived-section').style.display = 'block';

    let totalBal = 0;
    let emptyCount = 0;

    for (let i = 0; i < 30 && emptyCount < 10; i++) {
      const child = external.deriveChild(i);
      const { address } = bitcoin.payments.p2wpkh({
        pubkey: child.publicKey,
        network: bitcoin.networks.bitcoin
      });

      try {
        const info = await apiFetch(`/address/${address}`);
        const bal = (info.chain_stats.funded_txo_sum - info.chain_stats.spent_txo_sum) / 1e8;
        const hasTxs = info.chain_stats.tx_count > 0;

        if (hasTxs) {
          emptyCount = 0;
          totalBal += bal;
          const isMatch = (address === currentAddress);
          derived.push({ index: i, address, balance: bal, match: isMatch });
        } else {
          emptyCount++;
        }
      } catch (e) {
        emptyCount++;
      }
    }

    if (derived.length === 0) {
      listEl.innerHTML = '<div class="empty"><i class="ri-search-line"></i>No active addresses found in scanned window</div>';
    } else {
      let html = '';
      derived.forEach(d => {
        html += `<div class="derived-item ${d.match ? 'match' : ''}">
          <span class="idx">#${d.index}</span>
          <span class="daddr">${d.address}</span>
          <span class="dbal">${d.balance.toFixed(8)} BTC</span>
          ${d.match ? '<span style="color:var(--green);font-size:11px">✓ TARGET MATCH</span>' : ''}
        </div>`;
      });
      listEl.innerHTML = html;
    }

    showToast(`Scan complete. Found ${derived.length} active addresses.`, 'success');
  } catch (e) {
    console.error(e);
    showToast('Recovery error: ' + e.message, 'error');
  }
};

window.matchAddress = async function() {

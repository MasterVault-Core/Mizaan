.modal-close:hover{background:var(--red);color:#fff}
.modal-body{padding:24px}

.seed-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:20px}
.seed-word{position:relative}
.seed-word label{position:absolute;left:8px;top:50%;transform:translateY(-50%);font-size:9px;color:var(--text3);pointer-events:none}
.seed-word input{width:100%;padding:8px 8px 8px 28px;background:var(--bg3);border:1px solid var(--border);border-radius:6px;color:var(--text);font-family:inherit;font-size:12px}
.seed-word input:focus{outline:none;border-color:var(--cyan)}

.btn{padding:10px 20px;border-radius:8px;border:none;font-family:inherit;font-size:12px;font-weight:700;cursor:pointer;transition:.2s;text-transform:uppercase;letter-spacing:1px;display:inline-flex;align-items:center;gap:8px}
.btn-primary{background:linear-gradient(135deg,var(--orange),#e2820a);color:#fff}
.btn-primary:hover{box-shadow:0 0 20px rgba(247,147,26,.4)}
.btn-green{background:linear-gradient(135deg,var(--green),#00cc66);color:#000}
.btn-outline{background:transparent;border:1px solid var(--border);color:var(--text)}
.btn-outline:hover{border-color:var(--cyan);color:var(--cyan)}

.btn-row{display:flex;gap:10px;margin-top:16px;flex-wrap:wrap}

.stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.stat-box{background:var(--bg2);border:1px solid var(--border);border-radius:10px;padding:14px;text-align:center}
.stat-box .val{font-size:20px;font-weight:700;color:var(--cyan)}
.stat-box .lbl{font-size:9px;text-transform:uppercase;letter-spacing:1px;color:var(--text3);margin-top:4px}

.loading{display:flex;align-items:center;justify-content:center;padding:40px;color:var(--text3);gap:10px}
.spinner{width:20px;height:20px;border:2px solid var(--border);border-top-color:var(--cyan);border-radius:50%;animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

.empty{text-align:center;padding:40px;color:var(--text3)}
.empty i{font-size:40px;margin-bottom:10px;display:block;opacity:.3}

.toast{position:fixed;top:70px;right:20px;background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:12px 20px;z-index:2000;transform:translateX(120%);transition:.3s;font-size:12px;display:flex;align-items:center;gap:8px}
.toast.show{transform:translateX(0)}
.toast.success{border-color:var(--green);color:var(--green)}
.toast.error{border-color:var(--red);color:var(--red)}
.toast.info{border-color:var(--cyan);color:var(--cyan)}

.derived-list{max-height:300px;overflow-y:auto;margin-top:12px}
.derived-item{display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:8px;margin-bottom:4px;background:var(--bg);border:1px solid var(--border);font-size:11px}
.derived-item .idx{color:var(--text3);min-width:30px}
.derived-item .daddr{color:var(--cyan);flex:1;word-break:break-all}
.derived-item .dbal{color:var(--green);font-weight:700}

.recovery-fab{position:fixed;bottom:24px;right:24px;z-index:50}
.recovery-fab button{width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,var(--orange),#e2820a);border:none;color:#fff;font-size:22px;cursor:pointer;box-shadow:0 4px 20px rgba(247,147,26,.4);transition:.3s}
.recovery-fab button:hover{transform:scale(1.1)}

.bump-input{display:flex;gap:8px;margin-top:10px}
.bump-input input{flex:1;padding:8px 12px;background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);font-family:inherit;font-size:12px}
.bump-input input:focus{outline:none;border-color:var(--cyan)}

@media(max-width:1024px){
  .two-col{grid-template-columns:1fr}
  .balance-grid{grid-template-columns:1fr}
  .stats-row{grid-template-columns:repeat(2,1fr)}
}
</style>
</head>
<body>

<div class="app">
  <div class="topbar">
    <div class="logo">
      <div class="logo-icon">₿</div>
      <span>WALLET<span style="color:var(--cyan)">CTRL</span></span>
    </div>
    <div class="network-tabs">
      <div class="net-tab active" data-net="mainnet" onclick="switchNet('mainnet')">Mainnet</div>
      <div class="net-tab" data-net="signet" onclick="switchNet('signet')">Signet</div>
      <div class="net-tab" data-net="testnet" onclick="switchNet('testnet')">Testnet</div>
    </div>
    <div class="topbar-right">
      <div class="conn-status"><div class="conn-dot"></div> <span>Connected</span></div>
      <div class="block-height">Block: <span id="block-height">------</span></div>
    </div>
  </div>

  <div class="sidebar">
    <button class="side-btn active" title="Dashboard"><i class="ri-dashboard-3-line"></i></button>
    <button class="side-btn" title="Wallet"><i class="ri-wallet-3-line"></i></button>
    <button class="side-btn" title="UTXOs"><i class="ri-links-line"></i></button>
    <button class="side-btn" title="Transactions"><i class="ri-exchange-line"></i></button>
    <div class="side-sep"></div>
    <button class="side-btn" title="Network"><i class="ri-global-line"></i></button>
    <button class="side-btn" onclick="openRecovery()" title="Recovery"><i class="ri-key-2-line"></i></button>
    <div style="flex:1"></div>
    <button class="side-btn" onclick="refreshAll()" title="Refresh"><i class="ri-refresh-line"></i></button>
  </div>

  <div class="main">
    <div class="balance-grid">
      <div class="balance-card primary">
        <div class="bal-label">Confirmed Balance</div>
        <div class="bal-value orange" id="bal-confirmed">0.00000000</div>
        <div class="bal-sub">≈ $<span id="bal-usd">0.00</span> USD</div>
      </div>
      <div class="balance-card">
        <div class="bal-label">Unconfirmed</div>
        <div class="bal-value cyan" id="bal-unconfirmed">0.00000000</div>
        <div class="bal-sub">Pending transactions</div>
      </div>
      <div class="balance-card">
        <div class="bal-label">Total Transactions</div>
        <div class="bal-value green" id="tx-count">0</div>
        <div class="bal-sub">UTXOs: <span id="utxo-count">0</span></div>
      </div>
    </div>

    <div class="addr-bar">
      <i class="ri-wallet-line" style="color:var(--orange);font-size:18px"></i>
      <input type="text" id="address-input" value="bc1q9u6gz0ar79gvhhc0q6mhjyfevddvzmzzleap7v" style="flex:1;background:transparent;border:none;color:var(--cyan);font-family:inherit;font-size:12px;outline:none">
      <button onclick="loadAddress()"><i class="ri-search-line"></i> Load</button>
      <button onclick="copyAddress()"><i class="ri-file-copy-line"></i> Copy</button>
      <button onclick="openExplorer()"><i class="ri-external-link-line"></i> Explorer</button>
    </div>

    <div class="stats-row">
      <div class="stat-box"><div class="val" id="stat-mempool">--</div><div class="lbl">Mempool TXs</div></div>
      <div class="stat-box"><div class="val" id="stat-feerate">--</div><div class="lbl">Fee Rate (sat/vB)</div></div>
      <div class="stat-box"><div class="val" id="stat-hashrate">--</div><div class="lbl">Hash Rate</div></div>
      <div class="stat-box"><div class="val" id="stat-difficulty">--</div><div class="lbl">Difficulty</div></div>
    </div>

    <div class="two-col">
      <div class="card">
        <div class="card-header">
          <h3><i class="ri-links-line" style="color:var(--cyan)"></i> UTXO Set</h3>
          <span style="font-size:11px;color:var(--text3)" id="utxo-total">Total: 0 BTC</span>
        </div>
        <div class="card-body" style="padding:0;max-height:400px;overflow-y:auto">
          <div id="utxo-content">
            <div class="loading"><div class="spinner"></div> Loading UTXOs...</div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h3><i class="ri-exchange-line" style="color:var(--green)"></i> Transactions</h3>
        </div>
        <div class="card-body" style="max-height:400px;overflow-y:auto">
          <div id="tx-content">
            <div class="loading"><div class="spinner"></div> Loading transactions...</div>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3><i class="ri-global-line" style="color:var(--purple)"></i> Network Globe</h3>
      </div>
      <div class="globe-container">
        <canvas id="globe-canvas"></canvas>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3><i class="ri-speed-up-line" style="color:var(--yellow)"></i> Bump Fee (RBF)</h3>
      </div>
      <div class="card-body">
        <p style="font-size:12px;color:var(--text3);margin-bottom:12px">Replace-by-Fee: Increase fee of unconfirmed transaction</p>
        <div class="bump-input">
          <input type="text" id="bump-txid" placeholder="Transaction ID">
          <input type="number" id="bump-feerate" placeholder="sat/vB" style="max-width:120px">
          <button class="btn btn-primary" onclick="bumpFee()">Bump</button>
        </div>

let globeAngle = 0;
function drawGlobe(){
  const canvas = document.getElementById('globeCanvas');
  if(!canvas) return;
  const rect = canvas.parentElement.getBoundingClientRect();
  canvas.width = rect.width * 2;
  canvas.height = rect.height * 2;
  const ctx = canvas.getContext('2d');
  ctx.scale(2,2);
  const w = rect.width, h = rect.height;
  const cx = w/2, cy = h/2, r = Math.min(w,h)/2 - 4;
  
  ctx.clearRect(0,0,w,h);
  
  const glow = ctx.createRadialGradient(cx,cy,r*0.3,cx,cy,r*1.3);
  glow.addColorStop(0,'rgba(0,212,255,0.15)');
  glow.addColorStop(1,'rgba(0,212,255,0)');
  ctx.fillStyle = glow;
  ctx.fillRect(0,0,w,h);
  
  ctx.strokeStyle = 'rgba(0,212,255,0.15)';
  ctx.lineWidth = 0.5;
  for(let i=1;i<8;i++){
    ctx.beginPath();
    ctx.ellipse(cx, cy, r*(i/8), r, 0, 0, Math.PI*2);
    ctx.stroke();
  }
  for(let i=0;i<6;i++){
    const angle = (i/6)*Math.PI;
    ctx.beginPath();
    ctx.ellipse(cx, cy, r, r*Math.sin(angle), 0, 0, Math.PI*2);
    ctx.stroke();
  }
  
  for(let i=0;i<40;i++){
    const theta = (i/40)*Math.PI*2 + globeAngle;
    const phi = (i%5+1)/6*Math.PI;
    const x = cx + r*0.9*Math.sin(phi)*Math.cos(theta);
    const y = cy + r*0.9*Math.cos(phi);
    const size = (i%3)*0.5 + 0.5;
    ctx.fillStyle = `rgba(0,212,255,${0.3 + (i%5)*0.1})`;
    ctx.beginPath();
    ctx.arc(x,y,size,0,Math.PI*2);
    ctx.fill();
  }
  
  ctx.strokeStyle = 'rgba(0,212,255,0.4)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.arc(cx,cy,r,0,Math.PI*2);
  ctx.stroke();
  
  globeAngle += 0.005;
  requestAnimationFrame(drawGlobe);
}


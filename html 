    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SITARA SS — Unified Bitcoin Network Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/fontsource/fonts/jetbrains-mono@latest/latin-400-normal.css" rel="stylesheet">
    <style>
        * { font-family: 'JetBrains Mono', monospace; }
        body { background: #070b12; color: #e8eef7; }
        .card-bg {
            background: linear-gradient(135deg, #101824 0%, #0b121c 100%);
            border: 1px solid #283649;
            backdrop-filter: blur(10px);
        }
        .card-bg:hover {
            border-color: #f7931a44;
            box-shadow: 0 0 25px #f7931a15;
        }
        .pulse-dot {
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; box-shadow: 0 0 0 0 #38d996; }
            50% { opacity: 0.6; box-shadow: 0 0 0 6px #38d99600; }
        }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #070b12; }
        ::-webkit-scrollbar-thumb { background: #283649; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #f7931a88; }

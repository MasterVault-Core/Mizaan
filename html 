<script>
// ===== CHECKLIST =====
const checkedSteps = new Set();
function toggleCheck(n) {
  const item = document.querySelector(`.checklist-item[data-step="${n}"]`);
  const btn = item.querySelector('.check-btn i');
  if (checkedSteps.has(n)) {
    checkedSteps.delete(n);
    btn.classList.add('hidden');
    item.classList.remove('checked');
  } else {
    checkedSteps.add(n);
    btn.classList.remove('hidden');
    item.classList.add('checked');
  }
  document.getElementById('checkCount').textContent = `${checkedSteps.size}/4`;
  if (checkedSteps.size === 4) {
    toast('Emergency Steps Complete', 'اب صفائی کریں اور نیا بیکاپ بنائیں', 'fa-shield');
  }
}

// ===== BIP DETAILS =====
const bipData = {
  'BIP39': '<b class="text-blue-400">BIP39 - Mnemonic code for generating deterministic keys</b><br>یہ 12 یا 24 انگریزی الفاظ کی فہرست بناتا ہے جو human-readable ہوتے ہیں اور binary entropy کو represent کرتے ہیں۔ ہر لفظ 2048 کی wordlist سے آتا ہے۔ آخری الفاظ میں checksum ہوتا ہے۔',
  'BIP32': '<b class="text-blue-400">BIP32 - Hierarchical Deterministic Wallets</b><br>ایک ہی seed سے بے شمار keys اور addresses بنانے کا طریقہ۔ tree structure میں organize ہوتے ہیں۔ "Hardened" (\' نشان) derivation parent key leak سے بچاتا ہے۔',
  'BIP44': '<b class="text-yellow-400">BIP44 - Multi-Account Hierarchy for Coin Types</b><br>Path: <code class="text-yellow-400">m/44\'/coin\'/account\'/change/index</code><br>Legacy addresses جو <span class="text-white">1</span> سے شروع ہوتے ہیں۔',
  'BIP49': '<b class="text-orange-400">BIP49 - Nested SegWit</b><br>Path: <code class="text-orange-400">m/49\'/0\'/0\'</code><br>Addresses جو <span class="text-white">3</span> سے شروع ہوتے ہیں۔ P2SH-wrapped P2WPKH۔',
  'BIP84': '<b class="text-green-400">BIP84 - Native SegWit (Recommended)</b><br>Path: <code class="text-green-400">m/84\'/0\'/0\'</code><br>Addresses جو <span class="text-white">bc1q</span> سے شروع ہوتے ہیں۔ کم fees، بہتر privacy۔',
  'BIP86': '<b class="text-purple-400">BIP86 - Taproot (Latest)</b><br>Path: <code class="text-purple-400">m/86\'/0\'/0\'</code><br>Addresses جو <span class="text-white">bc1p</span> سے شروع ہوتے ہیں۔ Schnorr signatures، advanced scripts۔',
  'BIP48': '<b class="text-blue-400">BIP48 - Multi-sig Hierarchy</b><br>Multi-signature wallets کے لیے derivation path۔ 2-of-3، 3-of-5 وغیرہ۔',
  'BIP173': '<b class="text-blue-400">BIP173 - Bech32 format</b><br>bc1... addresses کا encoding format۔ Case-insensitive، better error detection۔',
  'Sparrow': '<b class="text-green-400">Sparrow Wallet</b><br>Desktop Bitcoin wallet۔ Hardware wallet support، CoinControl، PSBT، multi-sig۔ Open source۔ <span class="text-yellow-400">تجویز کردہ</span>۔',
  'Electrum': '<b class="text-green-400">Electrum</b><br>Lightweight Bitcoin wallet۔ 2011 سے موجود۔ Fast، reliable، hardware wallet support۔ Open source۔'
};

function showBIP(key) {
  const el = document.getElementById('bipDetail');
  document.getElementById('bipDetailContent').innerHTML = bipData[key];
  el.classList.remove('hidden');
  el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

// ===== SHA-256 WebCrypto =====
async function sha256(bytes) {
  const hash = await crypto.subtle.digest('SHA-256', bytes);
  return Array.from(new Uint8Array(hash)).map(b=>b.toString(16).padStart(2,'0')).join('');
}

async function runSHA256() {
  const input = document.getElementById('shaInput').value;
  if (!input) return;
  
  // SAFETY CHECK
  const words = input.trim().split(/\s+/);
  if (words.length === 12 || words.length === 24) {
    toast('⚠ WARNING', 'یہ seed phrase لگ رہا ہے! کبھی بھی آن لائن مت ڈالیں', 'fa-triangle-exclamation');
    return;
  }
  
  const t0 = performance.now();
  try {
    const enc = new TextEncoder().encode(input);
    const h1 = await sha256(enc);
    const h1bytes = new Uint8Array(h1.match(/.{2}/g).map(b=>parseInt(b,16)));
    const h2 = await sha256(h1bytes);
    const t1 = performance.now();
    document.getElementById('sha1Out').textContent = h1;
    document.getElementById('sha2Out').textContent = h2;
    document.getElementById('hashTime').textContent = (t1-t0).toFixed(2)+'ms';
  } catch(e) {
    document.getElementById('sha1Out').textContent = 'ERROR';
  }
}

// ===== TOAST =====
function toast(title, msg, icon='fa-check') {
  const t = document.getElementById('toast');
  document.getElementById('tTitle').textContent = title;
  document.getElementById('tMsg').textContent = msg;
  document.getElementById('tIcon').className = `fa-solid ${icon} lfc-red text-xs`;
  t.style.transform='translateY(0)'; t.style.opacity='1';
  setTimeout(()=>{ t.style.transform='translateY(20px)'; t.style.opacity='0'; }, 3500);
}

// Init
document.addEventListener('DOMContentLoaded', () => {
  runSHA256();
});
</script>

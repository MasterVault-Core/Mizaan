  </div>
</div>

<div class="recovery-fab">
  <button onclick="openRecovery()" title="RECOVERY"><i class="ri-key-2-line"></i></button>
</div>

<div class="modal-overlay" id="recovery-modal">
  <div class="modal">
    <div class="modal-header">
      <h2><i class="ri-key-2-line"></i> Wallet Recovery</h2>
      <button class="modal-close" onclick="closeRecovery()"><i class="ri-close-line"></i></button>
    </div>
    <div class="modal-body">
      <p style="font-size:12px;color:var(--text3);margin-bottom:16px">Enter your BIP39 seed phrase to derive wallet addresses</p>
      <div class="seed-grid" id="seed-grid"></div>
      <div class="btn-row">
        <button class="btn btn-primary" onclick="recoverWallet()"><i class="ri-shield-check-line"></i> Recover</button>
        <button class="btn btn-outline" onclick="clearSeed()"><i class="ri-delete-bin-line"></i> Clear</button>
      </div>
      <div id="derived-section" style="display:none;margin-top:20px">
        <div style="background:var(--bg3);border:1px solid var(--border);border-radius:10px;padding:16px">
          <h4 style="font-size:12px;color:var(--text2);margin-bottom:10px">Derived Addresses (BIP84)</h4>
          <div class="derived-list" id="derived-list"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script type="module">
const NETWORKS = {
  mainnet: { api: 'https://mempool.space/api', explorer: 'https://mempool.space' },
  signet: { api: 'https://mempool.space/signet/api', explorer: 'https://mempool.space/signet' },
  testnet: { api: 'https://mempool.space/testnet/api', explorer: 'https://mempool.space/testnet' }
};

let currentNet = 'mainnet';
let currentAddress = 'bc1q9u6gz0ar79gvhhc0q6mhjyfevddvzmzzleap7v';
let addressData = null;
let btcPrice = 0;

function getApi() { return NETWORKS[currentNet].api; }

async function apiFetch(path) {
  const res = await fetch(`${getApi()}${path}`);
  if (!res.ok) throw new Error(`API Error: ${res.status}`);
  return res.json();
}

async function apiText(path) {
  const res = await fetch(`${getApi()}${path}`);
  if (!res.ok) throw new Error(`API Error: ${res.status}`);
  return res.text();
}

async function fetchAddressInfo() {
  try {
    document.getElementById('utxo-content').innerHTML = '<div class="loading"><div class="spinner"></div> Loading...</div>';
    document.getElementById('tx-content').innerHTML = '<div class="loading"><div class="spinner"></div> Loading...</div>';

    const [info, utxos, txs] = await Promise.all([
      apiFetch(`/address/${currentAddress}`),
      apiFetch(`/address/${currentAddress}/utxo`),
      apiFetch(`/address/${currentAddress}/txs`)
    ]);

    addressData = info;
    renderBalance(info, utxos);
    renderUtxos(utxos);
    renderTxs(txs);
  } catch (e) {
    document.getElementById('utxo-content').innerHTML = `<div class="empty"><i class="ri-error-warning-line"></i>${e.message}</div>`;
    document.getElementById('tx-content').innerHTML = `<div class="empty"><i class="ri-error-warning-line"></i>${e.message}</div>`;
    showToast('Error: ' + e.message, 'error');
  }
}

async function fetchNetworkStats() {
  try {
    const [mempoolInfo, fees, priceRes] = await Promise.all([
      apiFetch('/mempool'),
      apiFetch('/v1/fees/recommended'),
      fetch('https://mempool.space/api/v1/prices').then(r => r.json()).catch(() => ({ USD: 0 }))
    ]);

    btcPrice = priceRes.USD || 0;
    document.getElementById('stat-mempool').textContent = (mempoolInfo.count || 0).toLocaleString();
    document.getElementById('stat-feerate').textContent = fees.halfHourFee || '--';

    if (addressData) {
      const total = (addressData.chain_stats.funded_txo_sum - addressData.chain_stats.spent_txo_sum) / 1e8;
      document.getElementById('bal-usd').textContent = (total * btcPrice).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
  } catch (e) {
    console.error(e);
  }

  try {
    const hashRate = await apiFetch('/v1/mining/hashrate/3d');
    if (hashRate.currentHashrate) {
      document.getElementById('stat-hashrate').textContent = (hashRate.currentHashrate / 1e18).toFixed(1) + ' EH/s';
    }
    if (hashRate.currentDifficulty) {
      document.getElementById('stat-difficulty').textContent = (hashRate.currentDifficulty / 1e12).toFixed(1) + 'T';
    }
  } catch (e) {}
}

async function fetchBlockHeight() {
  try {
    const h = await apiText('/blocks/tip/height');
    document.getElementById('block-height').textContent = parseInt(h).toLocaleString();
  } catch (e) {}
}

function renderBalance(info, utxos) {
  const confirmed = (info.chain_stats.funded_txo_sum - info.chain_stats.spent_txo_sum) / 1e8;
  const unconfirmed = (info.mempool_stats.funded_txo_sum - info.mempool_stats.spent_txo_sum) / 1e8;
  const totalTxs = info.chain_stats.tx_count + info.mempool_stats.tx_count;

  document.getElementById('bal-confirmed').textContent = confirmed.toFixed(8) + ' BTC';
  document.getElementById('bal-unconfirmed').textContent = unconfirmed.toFixed(8) + ' BTC';
  document.getElementById('tx-count').textContent = totalTxs.toLocaleString();
  document.getElementById('utxo-count').textContent = utxos.length;
  document.getElementById('bal-usd').textContent = (confirmed * btcPrice).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function renderUtxos(utxos) {
  if (!utxos.length) {
    document.getElementById('utxo-content').innerHTML = '<div class="empty"><i class="ri-inbox-line"></i>No UTXOs</div>';
    document.getElementById('utxo-total').textContent = 'Total: 0 BTC';
    return;
  }

  let total = 0;
  let html = '<table class="utxo-table"><thead><tr><th>#</th><th>TXID</th><th>Vout</th><th>Value</th><th>Status</th></tr></thead><tbody>';

  utxos.forEach((u, i) => {
    total += u.value;
    const btc = (u.value / 1e8).toFixed(8);
    const shortTxid = u.txid.substring(0, 8) + '...' + u.txid.substring(56);
    html += `<tr>
      <td style="color:var(--text3)">${i + 1}</td>
      <td class="txid" onclick="window.open('${NETWORKS[currentNet].explorer}/tx/${u.txid}','_blank')">${shortTxid}</td>
      <td>${u.vout}</td>
      <td class="amt">${btc}</td>
      <td><span class="conf-badge ${u.status.confirmed ? 'conf-yes' : 'conf-no'}">${u.status.confirmed ? '✓' : '⏳'}</span></td>
    </tr>`;
  });

  html += '</tbody></table>';
  document.getElementById('utxo-content').innerHTML = html;
  document.getElementById('utxo-total').textContent = `Total: ${(total / 1e8).toFixed(8)} BTC`;
}

function renderTxs(txs) {
  if (!txs.length) {
    document.getElementById('tx-content').innerHTML = '<div class="empty"><i class="ri-exchange-line"></i>No transactions</div>';
    return;
  }

  let html = '';
  txs.slice(0, 20).forEach(tx => {
    const isIncoming = tx.vout.some(v => v.scriptpubkey_address === currentAddress);
    let amount = 0;

    if (isIncoming) {
      tx.vout.forEach(v => {
        if (v.scriptpubkey_address === currentAddress) amount += v.value;
      });
    } else {
      tx.vin.forEach(v => {
        if (v.prevout && v.prevout.scriptpubkey_address === currentAddress) amount += v.prevout.value;
      });
      amount = -amount;
    }

    const btc = (amount / 1e8).toFixed(8);
    const time = tx.status.block_time ? timeAgo(tx.status.block_time * 1000) : 'Pending';

    html += `<div class="tx-item" onclick="window.open('${NETWORKS[currentNet].explorer}/tx/${tx.txid}','_blank')">
      <div class="tx-icon ${isIncoming ? 'in' : 'out'}">
        <i class="ri-arrow-${isIncoming ? 'down' : 'up'}-line"></i>
      </div>
      <div class="tx-info">
        <div class="tx-type">${isIncoming ? 'Received' : 'Sent'}</div>
        <div class="tx-time">${tx.txid.substring(0, 10)}... · ${time}</div>
      </div>
      <div class="tx-amt">
        <div class="val ${isIncoming ? 'pos' : 'neg'}">${isIncoming ? '+' : ''}${btc} BTC</div>
        <span class="tx-status ${tx.status.confirmed ? 'tx-confirmed' : 'tx-pending'}">${tx.status.confirmed ? '✓' : '⏳'}</span>
      </div>
    </div>`;
  });

  document.getElementById('tx-content').innerHTML = html;
}

function timeAgo(ts) {
  const diff = Date.now() - ts;
  const mins = Math.floor(diff / 60000);
  if (mins < 60) return mins + 'm ago';
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return hrs + 'h ago';
  return Math.floor(hrs / 24) + 'd ago';
}

window.switchNet = function(net) {
  currentNet = net;
  document.querySelectorAll('.net-tab').forEach(t => t.classList.toggle('active', t.dataset.net === net));
  fetchAddressInfo();
  showToast(`Switched to ${net}`, 'info');
};

window.loadAddress = function() {
  currentAddress = document.getElementById('address-input').value.trim();
  fetchAddressInfo();
};

window.copyAddress = function() {
  navigator.clipboard.writeText(currentAddress).then(() => showToast('Copied!', 'success'));
};

window.openExplorer = function() {
  window.open(`${NETWORKS[currentNet].explorer}/address/${currentAddress}`, '_blank');
};

window.bumpFee = function() {
  const txid = document.getElementById('bump-txid').value.trim();
  const feerate = document.getElementById('bump-feerate').value.trim();
  if (!txid || !feerate) {
    showToast('Enter TXID and fee rate', 'error');
    return;
  }
  const cmd = `bitcoin-cli bumpfee "${txid}" '{"fee_rate": ${feerate}}'`;
  navigator.clipboard.writeText(cmd).then(() => showToast('Command copied', 'success'));
};

window.refreshAll = function() {
  showToast('Refreshing...', 'info');
  fetchAddressInfo();
  fetchNetworkStats();
};

function showToast(msg, type = 'info') {
  const t = document.getElementById('toast');
  t.className = `toast ${type} show`;
  t.innerHTML = `<i class="ri-${type === 'success' ? 'check' : type === 'error' ? 'error-warning' : 'information'}-line"></i> ${msg}`;
  setTimeout(() => t.classList.remove('show'), 3000);
}

function initSeedGrid() {
  const grid = document.getElementById('seed-grid');
  grid.innerHTML = '';
  for (let i = 0; i < 24; i++) {
    const div = document.createElement('div');
    div.className = 'seed-word';
    div.innerHTML = `<label>${i + 1}</label><input type="text" id="seed-${i}" autocomplete="off" spellcheck="false">`;
    grid.appendChild(div);
  }
}

window.openRecovery = function() {
  initSeedGrid();
  document.getElementById('recovery-modal').classList.add('show');
  document.getElementById('derived-section').style.display = 'none';
};

window.closeRecovery = function() {
  document.getElementById('recovery-modal').classList.remove('show');
};

window.clearSeed = function() {
  for (let i = 0; i < 24; i++) {
    document.getElementById(`seed-${i}`).value = '';
  }
};

window.recoverWallet = async function() {
  const words = [];
  for (let i = 0; i < 24; i++) {
    const v = document.getElementById(`seed-${i}`).value.trim().toLowerCase();
    if (v) words.push(v);
  }

  if (words.length < 12) {
    showToast('Enter at least 12 words', 'error');
    return;
  }

  const phrase = words.join(' ');
  showToast('Deriving addresses...', 'info');

  try {
    const bitcoin = await import('https://esm.sh/bitcoinjs-lib@6.1.5');
    const ecc = await import('https://esm.sh/tiny-secp256k1@1.7.1');
    const { BIP32Factory } = await import('https://esm.sh/bip32@4.0.0');
    const bip39 = await import('https://esm.sh/bip39@3.1.0');

    await ecc.init();
    const bip32 = BIP32Factory(ecc);

    const seed = await bip39.mnemonicToSeed(phrase);
    const root = bip32.fromSeed(seed);
    const account = root.derivePath("m/84'/0'/0'");
    const external = account.deriveChild(0);

    const derived = [];
    const listEl = document.getElementById('derived-list');
    listEl.innerHTML = '<div class="loading"><div class="spinner"></div> Checking...</div>';
    document.getElementById('derived-section').style.display = 'block';

    let totalBal = 0;
    let emptyCount = 0;

    for (let i = 0; i < 20 && emptyCount < 10; i++) {
      const child = external.deriveChild(i);
      const { address } = bitcoin.payments.p2wpkh({
        pubkey: child.publicKey,
        network: bitcoin.networks.bitcoin
      });

      try {
        const info = await apiFetch(`/address/${address}`);
        const bal = (info.chain_stats.funded_txo_sum - info.chain_stats.spent_txo_sum) / 1e8;
        const hasTxs = info.chain_stats.tx_count > 0;

        if (hasTxs) {
          emptyCount = 0;
          totalBal += bal;
          derived.push({ index: i, address, balance: bal });
        } else {
          emptyCount++;
        }
      } catch (e) {
        emptyCount++;
      }
    }

    if (derived.length === 0) {
      listEl.innerHTML = '<div class="empty"><i class="ri-search-line"></i>No used addresses found</div>';
    } else {
      let html = '';
      derived.forEach(d => {
        html += `<div class="derived-item">
          <span class="idx">#${d.index}</span>
          <span class="daddr">${d.address}</span>
          <span class="dbal">${d.balance.toFixed(8)} BTC</span>
        </div>`;
      });
      listEl.innerHTML = html;
    }

    showToast(`Found ${derived.length} addresses. Total: ${totalBal.toFixed(8)} BTC`, 'success');
  } catch (e) {
    console.error(e);
    showToast('Error: ' + e.message, 'error');
  }
};

function initGlobe() {
  const canvas = document.getElementById('globe-canvas');
  const container = canvas.parentElement;
  const w = container.clientWidth;
  const h = container.clientHeight;

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(45, w / h, 0.1, 1000);
  camera.position.z = 3.5;

  const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
  renderer.setSize(w, h);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

  const globeGeo = new THREE.SphereGeometry(1, 36, 36);
  const globeMat = new THREE.MeshBasicMaterial({ color: 0x00f0ff, wireframe: true, transparent: true, opacity: 0.08 });
  const globe = new THREE.Mesh(globeGeo, globeMat);
  scene.add(globe);

  const dotGeo = new THREE.SphereGeometry(0.012, 8, 8);
  const nodes = [];
  for (let i = 0; i < 80; i++) {
    const phi = Math.acos(-1 + (2 * i) / 80);
    const theta = Math.sqrt(80 * Math.PI) * phi;
    const x = Math.cos(theta) * Math.sin(phi);
    const y = Math.sin(theta) * Math.sin(phi);
    const z = Math.cos(phi);

    const colors = [0x00ff88, 0x00f0ff, 0xf7931a, 0xa855f7];
    const mat = new THREE.MeshBasicMaterial({ color: colors[i % 4] });
    const dot = new THREE.Mesh(dotGeo, mat);
    dot.position.set(x, y, z);
    globe.add(dot);
    nodes.push(dot);
  }

  const arcMat = new THREE.LineBasicMaterial({ color: 0x00f0ff, transparent: true, opacity: 0.15 });
  for (let i = 0; i < 30; i++) {
    const a = nodes[Math.floor(Math.random() * nodes.length)].position.clone();
    const b = nodes[Math.floor(Math.random() * nodes.length)].position.clone();
    const mid = a.clone().add(b).multiplyScalar(0.5).normalize().multiplyScalar(1.3);
    const curve = new THREE.QuadraticBezierCurve3(a, mid, b);
    const points = curve.getPoints(20);
    const geo = new THREE.BufferGeometry().setFromPoints(points);
    globe.add(new THREE.Line(geo, arcMat));
  }

  function animate() {
    requestAnimationFrame(animate);
    globe.rotation.y += 0.002;
    nodes.forEach((n, i) => {
      n.scale.setScalar(1 + Math.sin(Date.now() * 0.003 + i) * 0.3);
    });
    renderer.render(scene, camera);
  }
  animate();

  window.addEventListener('resize', () => {
    const w2 = container.clientWidth;
    const h2 = container.clientHeight;
    camera.aspect = w2 / h2;
    camera.updateProjectionMatrix();
    renderer.setSize(w2, h2);
  });
}


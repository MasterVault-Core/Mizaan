  const body = document.getElementById('txBody');
  body.innerHTML = txData.map((t)=>{
    const isRecv = t.type === 'Received';
    const color = isRecv ? 'text-green-400' : 'text-red-400';
    const icon = isRecv 
      ? '<svg class="w-4 h-4 inline" viewBox="0 0 24 24" fill="currentColor"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>'

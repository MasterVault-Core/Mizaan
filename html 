    <!-- Configuration / Target Address -->
    <div class="card-bg rounded-2xl p-5">
        <div class="flex flex-col md:flex-row items-end gap-4">
            <div class="flex-1 w-full space-y-1.5">
                <label class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Target Bitcoin Address (Mainnet)</label>
                <input id="targetAddress" type="text" value="bc1q9u6gz0ar79gvhhc0q6mhjyfevddvzmzzleap7v" spellcheck="false" 
                    class="w-full bg-[#05090f] border border-[#283649] text-white text-sm px-4 py-3 rounded-xl focus:outline-none focus:border-[#f7931a] font-mono">
            </div>
            <div class="w-full md:w-48 space-y-1.5">
                <label class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Auto Poll Interval</label>
                <select id="pollInterval" class="w-full bg-[#05090f] border border-[#283649] text-white text-sm px-4 py-3 rounded-xl focus:outline-none focus:border-[#f7931a]">
                    <option value="0">Disabled</option>
                    <option value="30000">30 Seconds</option>
                    <option value="60000" selected>60 Seconds</option>
                    <option value="300000">5 Minutes</option>

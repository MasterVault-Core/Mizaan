    return `
    <tr class="row-hover border-t border-[#1a2a5a]/50">
      <td class="px-5 py-3 text-slate-300">${t.date}</td>
      <td class="px-5 py-3 text-cyan-300 cursor-pointer hover:text-cyan-200" onclick="copyText('${t.txid}','TxID')">${t.txid}</td>
      <td class="px-5 py-3 ${color}">

    <script>
        const SAT_PER_BTC = 100000000;
        let activeTimer = null;
        let lastSnapshot = null;

        function log(msg, type = 'INFO') {
            const box = document.getElementById('auditLog');
            const time = new Date().toLocaleTimeString();
            let color = 'text-gray-300';
            if (type === 'SUCCESS') color = 'text-[#38d996]';
            if (type === 'ERROR') color = 'text-[#ff6b6b]';
            if (type === 'WARN') color = 'text-[#ffd17a]';
            
            box.innerHTML += `<div class="${color}">[${time}] [${type}] ${msg}</div>`;
            box.scrollTop = box.scrollHeight;
        }

        async function fetchWithFallback(urlPrimary, urlFallback) {
            try {
                let res = await fetch(urlPrimary, { cache: 'no-store' });
                if (res.ok) return await res.json();
            } catch (e) {
                log(`Primary API error, switching to fallback.`, 'WARN');
            }
            let resFb = await fetch(urlFallback, { cache: 'no-store' });
            if (!resFb.ok) throw new Error('All blockchain endpoints failed.');
            return await resFb.json();
        }

        async function fetchAllData() {
            const address = document.getElementById('targetAddress').value.trim();
            if (!address) {
                alert('براہ کرم درست بٹ کوائن ایڈریس درج کریں۔');
                return;
            }

            const btn = document.getElementById('refreshBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Syncing...';
            document.getElementById('connectionStatus').textContent = 'Syncing...';

            log(`Initiating chain fetch for address: ${address.substring(0, 10)}...`);

            try {
                // Parallel data retrieval from mempool.space with blockstream fallback
                const [utxos, txs, blockHeight, fees] = await Promise.all([
                    fetchWithFallback(`https://mempool.space/api/address/${address}/utxo`, `https://blockstream.info/api/address/${address}/utxo`),
                    fetchWithFallback(`https://mempool.space/api/address/${address}/txs`, `https://blockstream.info/api/address/${address}/txs`),
                    fetchWithFallback(`https://mempool.space/api/blocks/tip/height`, `https://blockstream.info/api/blocks/tip/height`),
                    fetchWithFallback(`https://mempool.space/api/v1/fees/recommended`, `https://mempool.space/api/v1/fees/recommended`).catch(() => ({ fastestFee: 15 }))
                ]);

                processAndRender(address, utxos, txs, Number(blockHeight), fees);
                document.getElementById('connectionStatus').textContent = 'Live Connected';
                log(`Sync completed successfully. Total UTXOs: ${utxos.length}`, 'SUCCESS');
            } catch (err) {
                document.getElementById('connectionStatus').textContent = 'Connection Failed';
                log(`Error fetching blockchain data: ${err.message}`, 'ERROR');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-arrows-rotate"></i> Sync Chain';
            }
        }

        function processAndRender(address, utxos, txs, tipHeight, fees) {
            let totalSats = 0;
            let confirmedSats = 0;

            utxos.forEach(u => {
                totalSats += u.value;
                if (u.status && u.status.confirmed) {
                    confirmedSats += u.value;
                }
            });

            // UI Stat Updation
            document.getElementById('blockTip').textContent = '#' + tipHeight.toLocaleString();
            document.getElementById('statBalance').textContent = (totalSats / SAT_PER_BTC).toFixed(8);
            document.getElementById('statConfirmed').textContent = (confirmedSats / SAT_PER_BTC).toFixed(8);
            document.getElementById('statUtxoCount').textContent = utxos.length.toLocaleString();
            document.getElementById('statFee').textContent = fees.fastestFee ?? '—';
            
            // Approximate USD calculation (assuming ~$90k baseline or live estimation factor)
            const estUsd = (totalSats / SAT_PER_BTC) * 92000;
            document.getElementById('statUsd').textContent = `BTC ≈ $${Math.round(estUsd).toLocaleString()} USD`;

            // Render UTXOs Table
            const utxoBody = document.getElementById('utxoTableBody');
            if (utxos.length === 0) {
                utxoBody.innerHTML = `<tr><td colspan="6" class="p-6 text-center text-gray-500">No unspent outputs found for this address.</td></tr>`;
            } else {
                utxoBody.innerHTML = utxos.map((u, i) => {
                    const confs = u.status?.confirmed ? Math.max(0, tipHeight - u.status.block_height + 1) : 0;
                    return `
                        <tr class="hover:bg-white/[0.02] transition-colors">
                            <td class="p-3.5 text-gray-500">${i + 1}</td>
                            <td class="p-3.5 font-mono text-gray-300 truncate max-w-[180px]">${u.txid}</td>
                            <td class="p-3.5 text-gray-400">${u.vout}</td>
                            <td class="p-3.5 text-right font-bold text-white">${(u.value / SAT_PER_BTC).toFixed(8)}</td>
                            <td class="p-3.5 text-right ${confs > 0 ? 'text-[#38d996]' : 'text-[#ffd17a]'}">${confs.toLocaleString()}</td>
                            <td class="p-3.5 text-center">
                                <span class="text-[10px] px-2.5 py-1 rounded-full font-semibold ${confs > 0 ? 'bg-[#38d996]/10 text-[#38d996]' : 'bg-[#ffd17a]/10 text-[#ffd17a]'}">
                                    ${confs > 0 ? 'Confirmed' : 'Pending'}
                                </span>
                            </td>
                        </tr>
                    `;
                }).join('');
            }

            // Render Transactions Table
            const txBody = document.getElementById('txTableBody');
            if (!txs || txs.length === 0) {
                txBody.innerHTML = `<tr><td colspan="5" class="p-6 text-center text-gray-500">No transactions recorded.</td></tr>`;
            } else {
                txBody.innerHTML = txs.slice(0, 15).map(tx => {
                    const confs = tx.status?.confirmed ? Math.max(0, tipHeight - tx.status.block_height + 1) : 0;
                    return `
                        <tr class="hover:bg-white/[0.02] transition-colors">
                            <td class="p-3.5 font-mono text-blue-400 truncate max-w-[200px]">${tx.txid}</td>
                            <td class="p-3.5">
                                <span class="text-[10px] px-2.5 py-1 rounded-full font-semibold ${confs > 0 ? 'bg-[#38d996]/10 text-[#38d996]' : 'bg-[#ffd17a]/10 text-[#ffd17a]'}">
                                    ${confs > 0 ? 'Confirmed' : 'Unconfirmed'}
                                </span>
                            </td>
                            <td class="p-3.5 text-gray-400">${tx.status?.block_height || '—'}</td>
                            <td class="p-3.5 text-right text-gray-300">${confs.toLocaleString()}</td>
                            <td class="p-3.5 text-right text-gray-400">${tx.fee ? tx.fee.toLocaleString() : '—'}</td>
                        </tr>
                    `;
                }).join('');
            }

            // Cache Snapshot for Export
            lastSnapshot = {
                address: address,
                fetchedAt: new Date().toISOString(),
                tipHeight: tipHeight,
                balances: { totalSats, confirmedSats },
                utxos: utxos,
                transactions: txs
            };
        }

        function clearLogs() {
            document.getElementById('auditLog').innerHTML = '';
            log('Audit logs cleared by user.', 'INFO');
        }

        function exportSnapshot() {
            if (!lastSnapshot) {
                alert('پہلے بلاک چین ڈیٹا سنک (Sync) کریں۔');
                return;
            }
            const blob = new Blob([JSON.stringify(lastSnapshot, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `sitara-snapshot-${Date.now()}.json`;
            a.click();
            URL.revokeObjectURL(url);
            log('Public JSON snapshot exported locally.', 'SUCCESS');
        }

        // Auto Poll Configurator
        document.getElementById('pollInterval').onchange = (e) => {
            if (activeTimer) clearInterval(activeTimer);
            const interval = Number(e.target.value);
            if (interval > 0) {
                activeTimer = setInterval(fetchAllData, interval);
                log(`Auto poll timer set to ${interval / 1000} seconds.`, 'INFO');
            } else {
                log(`Auto poll timer disabled.`, 'INFO');
            }
        };

        // Initialize on load
        window.onload = () => {
            fetchAllData();
            activeTimer = setInterval(fetchAllData, 60000); // Default 60s
        };
    </script>

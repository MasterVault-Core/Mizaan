import * as bip39 from 'bip39';
import { BIP32Factory } from 'bip32';
import * as ecc from 'tiny-secp256k1';
import * as bitcoin from 'bitcoinjs-lib';

// Initialize secp256k1 ECC library
bitcoin.initEccLib(ecc);
const bip32 = BIP32Factory(ecc);

async function deriveOfflineAddresses(mnemonicPhrase, maxIndex = 20) {
  // 1. Validate Mnemonic
  if (!bip39.validateMnemonic(mnemonicPhrase)) {
    throw new Error("[SECURITY ERROR] Invalid BIP39 mnemonic checksum.");
  }

  // 2. Generate Seed (Isolated memory, no network call)
  const seed = await bip39.mnemonicToSeed(mnemonicPhrase);

  // 3. Create Root Node & Derive BIP84 Account Path (m/84'/0'/0'/0)
  const root = bip32.fromSeed(seed, bitcoin.networks.bitcoin);
  const account = root.derivePath("m/84'/0'/0'/0");

  const derivedAddresses = [];

  // 4. Derive Child Addresses & Public Keys
  for (let i = 0; i < maxIndex; i++) {
    const childNode = account.derive(i);
    
    // Generate Native SegWit (P2WPKH) payment object
    const payment = bitcoin.payments.p2wpkh({
      pubkey: childNode.publicKey,
      network: bitcoin.networks.bitcoin,
    });

    derivedAddresses.push({
      index: i,
      address: payment.address,
      publicKey: childNode.publicKey.toString('hex'),
      path: `m/84'/0'/0'/0/${i}`
    });
  }

  return derivedAddresses;
}

</head>
<body class="min-h-screen overflow-x-hidden p-4 lg:p-6 space-y-6">

    <!-- Header -->
    <header class="card-bg rounded-2xl p-4 flex flex-col md:flex-row items-center justify-between gap-4 sticky top-4 z-50">

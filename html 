                <div class="w-2.5 h-2.5 rounded-full bg-[#38d996] pulse-dot"></div>
                <span class="text-[#38d996] text-xs font-semibold" id="connectionStatus">Connecting...</span>
            </div>
            <div class="text-right hidden sm:block">
                <div class="text-[10px] text-gray-500 uppercase">Block Tip</div>
